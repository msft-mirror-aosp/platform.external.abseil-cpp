    ],
}

// Globally visible host-only library.
cc_library_host_static {
    name: "libabsl_host",
    whole_static_libs: ["libabsl"],
    export_static_lib_headers: ["libabsl"],
    stl: "libc++",
    visibility: ["//visibility:public"],
